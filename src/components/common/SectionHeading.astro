---
interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  description?: string;
  align?: 'left' | 'center';
  theme?: 'light' | 'dark';
  class?: string;
}

const {
  eyebrow,
  title,
  highlight,
  description,
  align = 'left',
  theme = 'light',
  class: className = '',
} = Astro.props;

const isDark = theme === 'dark';
---

<div class:list={[
  'w-full mb-12 sm:mb-16',
  align === 'center' ? 'text-center max-w-3xl mx-auto' : 'grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end',
  className
]}>
  <div class:list={[align === 'left' ? 'lg:col-span-7' : '']}>
    {eyebrow && (
      <span class:list={[
        'inline-block text-xs font-bold uppercase tracking-[0.12em] font-sans mb-3',
        isDark ? 'text-[#F05B36]' : 'text-[#E7430B]'
      ]}>
        {eyebrow}
      </span>
    )}
    <h2 class:list={[
      'text-3xl sm:text-4xl lg:text-[42px] font-heading font-normal leading-tight tracking-tight',
      isDark ? 'text-[#F7F8F8]' : 'text-[#111315]'
    ]}>
      {title}
      {highlight && (
        <span class="text-[#F05B36] font-medium block sm:inline"> {highlight}</span>
      )}
    </h2>
  </div>

  {description && (
    <div class:list={[
      align === 'left' ? 'lg:col-span-5' : 'mt-4',
      align === 'left' ? 'lg:text-right' : ''
    ]}>
      <p class:list={[
        'text-base sm:text-lg font-sans leading-relaxed',
        isDark ? 'text-[#CFC9C5]' : 'text-[#4A5157]',
        align === 'left' ? 'max-w-md lg:ml-auto' : 'mx-auto'
      ]}>
        {description}
      </p>
    </div>
  )}
</div>
