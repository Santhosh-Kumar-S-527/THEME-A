---
interface Props {
  text?: string;
  variant?: 'accent' | 'neutral' | 'dark' | 'outline';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  text,
  variant = 'accent',
  size = 'md',
  class: className = '',
} = Astro.props;

const variantStyles = {
  accent: 'bg-[rgba(240,91,54,0.12)] text-[#E7430B] border border-[rgba(240,91,54,0.3)]',
  neutral: 'bg-[#FAF7F5] text-[#4A5157] border border-[#E6E2DF]',
  dark: 'bg-[#111519] text-[#F7F8F8] border border-[#293036]',
  outline: 'bg-transparent text-[#6B737A] border border-[#E6E2DF]',
};

const sizeStyles = {
  sm: 'px-2.5 py-0.5 text-xs font-mono',
  md: 'px-3 py-1 text-xs font-sans font-medium',
};
---

<span class:list={['inline-flex items-center rounded-full transition-colors leading-normal', variantStyles[variant], sizeStyles[size], className]}>
  <slot>{text}</slot>
</span>
