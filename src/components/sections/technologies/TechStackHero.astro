---
import Container from '../../common/Container.astro';
---

<section class="py-20 bg-white">
  <Container class="text-center">
    <span class="inline-block text-xs font-bold uppercase tracking-[0.12em] text-[#E7430B] font-sans mb-3">
      Modern Stack & Architecture
    </span>
    <h1 class="text-4xl sm:text-5xl font-heading font-normal text-[#111315] max-w-3xl mx-auto mb-6">
      Scalable Foundations for <span class="text-[#E7430B]">Modern Enterprise</span>
    </h1>
    <p class="text-lg font-sans text-[#4A5157] max-w-2xl mx-auto leading-relaxed">
      From custom machine learning workflows to edge-deployed micro-frontends, our architectures are built for continuous uptime and evolvability.
    </p>
  </Container>
</section>
