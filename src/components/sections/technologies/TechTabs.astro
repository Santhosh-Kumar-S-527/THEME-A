---
import Container from '../../common/Container.astro';
import CardTech from '../../cards/CardTech.astro';
import { technologiesData } from '../../../data/technologies';
---

<section id="tech-tabs" class="py-20 bg-[#FAF7F5] border-y border-[#E6E2DF]">
  <Container>
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#E7430B] font-sans">
        Technology Matrix
      </span>
      <h2 class="text-3xl font-heading font-medium text-[#111315] mt-2">
        Core Domains & Specialized Tooling
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {technologiesData.map((tech) => (
        <CardTech tech={tech} />
      ))}
    </div>
  </Container>
</section>
