---
import Container from '../../common/Container.astro';
---

<section class="py-20 bg-white">
  <Container class="text-center">
    <span class="inline-block text-xs font-bold uppercase tracking-[0.12em] text-[#E7430B] font-sans mb-3">
      About Lingaasys
    </span>
    <h1 class="text-4xl sm:text-5xl font-heading font-normal text-[#111315] max-w-3xl mx-auto mb-6">
      Who is Lingaasys, <span class="text-[#E7430B]">What we build</span>
    </h1>
    <p class="text-lg font-sans text-[#4A5157] max-w-2xl mx-auto leading-relaxed">
      A team of passionate software architects, engineers, and designers dedicated to engineering resilient systems with human empathy.
    </p>
  </Container>
</section>
