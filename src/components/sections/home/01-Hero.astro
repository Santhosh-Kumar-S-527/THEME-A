---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
---

<section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 overflow-hidden bg-white">
  <!-- Soft background ambient glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-gradient-to-tr from-[#FDEEE8] via-[#FAF7F5] to-transparent rounded-full blur-3xl -z-10 pointer-events-none opacity-80"></div>

  <Container class="text-center">
    <!-- Centered Two-line Display Hero Headline -->
    <h1 class="display-hero text-4xl sm:text-6xl lg:text-7xl font-heading text-[#111315] max-w-4xl mx-auto mb-6 tracking-tight leading-[1.08]">
      Where Software <br class="hidden sm:inline" />
      <span class="text-[#111315]">Connects Human Ambition</span>
    </h1>

    <!-- Supporting Paragraph -->
    <p class="text-base sm:text-xl font-sans text-[#4A5157] max-w-2xl mx-auto mb-10 leading-relaxed">
      Lingaasys builds mission-critical technology for leading global enterprises uniting resilient cloud architecture, custom AI models, and human-centered design.
    </p>

    <!-- CTAs side by side -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-16">
      <Button href="/technologies" variant="primary" size="lg" withArrow={true}>
        See AI Details
      </Button>
      <Button href="#contact" variant="secondary" size="lg">
        Contact Us
      </Button>
    </div>

    <!-- Wide Rounded Hero Visual Container with hero.png -->
    <div class="relative mx-auto max-w-5xl rounded-3xl p-2 sm:p-4 bg-gradient-to-b from-[#FDEEE8] to-transparent border border-[#E6E2DF] shadow-2xl overflow-hidden group">
      <div class="relative rounded-2xl overflow-hidden bg-[#FAF7F5] border border-[#E6E2DF]/60 shadow-inner">
        <img
          src="/images/home/hero.png"
          alt="Lingaasys Hero Visual"
          class="w-full h-auto object-cover rounded-xl block"
          loading="eager"
        />
      </div>
    </div>
  </Container>
</section>
