---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
---

<section class="py-24 bg-[#050708] text-white border-b border-[#293036]">
  <Container>
    <div class="max-w-3xl">
      <span class="inline-block text-xs font-bold uppercase tracking-[0.12em] text-[#F05B36] font-sans mb-3">
        Industry Solutions
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-normal leading-tight text-white mb-6">
        Technology Built For <span class="text-[#F05B36]">Every Industry</span>
      </h1>
      <p class="text-lg font-sans text-[#CFC9C5] max-w-2xl mb-8 leading-relaxed">
        Deep domain expertise paired with resilient, scalable architectures designed to navigate rigorous regulatory and operational landscapes.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <Button href="#industries-grid" variant="primary" size="md">
          Explore Industries
        </Button>
        <Button href="#contact" variant="outline-dark" size="md">
          Talk to Us
        </Button>
      </div>
    </div>
  </Container>
</section>
