---
import Container from '../../common/Container.astro';
import Button from '../../common/Button.astro';
---

<section class="py-20 bg-white">
  <Container class="text-center">
    <span class="inline-block text-xs font-bold uppercase tracking-[0.12em] text-[#E7430B] font-sans mb-3">
      Careers at Lingaasys
    </span>
    <h1 class="text-4xl sm:text-5xl font-heading font-normal text-[#111315] max-w-3xl mx-auto mb-6">
      Build What Matters. <span class="text-[#E7430B]">Grow With People.</span>
    </h1>
    <p class="text-lg font-sans text-[#4A5157] max-w-2xl mx-auto mb-8 leading-relaxed">
      Join our multidisciplinary engineering collective where craft, empathy, and intellectual curiosity are celebrated.
    </p>
    <Button href="#open-positions" variant="primary" size="md">
      Explore Open Positions
    </Button>
  </Container>
</section>
