---
import Container from '../common/Container.astro';
import ContactForm from './ContactForm.astro';
import { footerColumns } from '../../data/navigation';

interface Props {
  includeContactForm?: boolean;
}

const { includeContactForm = true } = Astro.props;
---

<footer class="bg-[#050708] text-[#F7F8F8] pt-16 pb-12 border-t border-[#293036] relative overflow-hidden" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <Container>
    {includeContactForm && (
      <div class="mb-20">
        <ContactForm />
      </div>
    )}

    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 pb-16 border-b border-[#293036]">
      <!-- Brand & Social Column -->
      <div class="lg:col-span-4 space-y-6">
        <a href="/" class="flex items-center group" aria-label="Lingaasys - Back to homepage">
          <img
            src="/images/logo/darkLogo 2.svg"
            alt="Lingaasys"
            class="h-9 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
          />
        </a>

        <p class="text-sm font-sans text-[#6B737A] max-w-sm leading-relaxed">
          Creating Systems for Humanity. Enterprise technology crafted with precision, warmth, and practical innovation.
        </p>

        <!-- Social Icons -->
        <div class="flex items-center gap-3 pt-2">
          <!-- LinkedIn -->
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-[#111519] border border-[#293036] flex items-center justify-center text-[#CFC9C5] hover:text-[#E7430B] hover:border-[#E7430B] transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <!-- GitHub -->
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-[#111519] border border-[#293036] flex items-center justify-center text-[#CFC9C5] hover:text-[#E7430B] hover:border-[#E7430B] transition-colors"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
          <!-- X / Twitter -->
          <a
            href="https://twitter.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-[#111519] border border-[#293036] flex items-center justify-center text-[#CFC9C5] hover:text-[#E7430B] hover:border-[#E7430B] transition-colors"
            aria-label="X / Twitter"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Link Columns -->
      <div class="lg:col-span-8 grid grid-cols-2 sm:grid-cols-4 gap-8">
        {footerColumns.map((col) => (
          <div>
            <h3 class="font-heading font-medium text-sm text-white uppercase tracking-wider mb-4">
              {col.title}
            </h3>
            <ul class="space-y-2.5 text-sm font-sans">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[#CFC9C5] hover:text-[#E7430B] transition-colors focus-visible:outline-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[#6B737A]">
      <p>© {new Date().getFullYear()} Lingaasys Systems Inc. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
        <a href="#" class="hover:text-white transition-colors">Cookie Preferences</a>
      </div>
    </div>
  </Container>
</footer>
