---
import StarRating from '../common/StarRating.astro';
import type { TestimonialItem } from '../../types';

interface Props {
  testimonial: TestimonialItem;
}

const { testimonial } = Astro.props;
---

<div class="bg-white border border-[#E6E2DF] hover:border-[#CFC9C5] rounded-2xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 hover:shadow-lg">
  <div>
    <!-- Star Rating -->
    <div class="mb-4">
      <StarRating rating={testimonial.rating} />
    </div>

    <!-- Quote -->
    <blockquote class="text-sm sm:text-base font-sans text-[#111315] leading-relaxed mb-6 italic">
      "{testimonial.quote}"
    </blockquote>
  </div>

  <!-- Author Info -->
  <div class="flex items-center gap-3 pt-4 border-t border-[#E6E2DF]">
    {testimonial.avatar ? (
      <img
        src={testimonial.avatar}
        alt={testimonial.author}
        class="w-11 h-11 rounded-full object-cover border border-[#E6E2DF]"
        loading="lazy"
      />
    ) : (
      <div class="w-11 h-11 rounded-full bg-[rgba(240,91,54,0.12)] text-[#E7430B] font-bold font-heading flex items-center justify-center">
        {testimonial.author.charAt(0)}
      </div>
    )}
    <div>
      <div class="font-heading font-semibold text-sm text-[#E7430B]">
        {testimonial.author}
      </div>
      <div class="text-xs font-sans text-[#6B737A]">
        {testimonial.role} · {testimonial.company}
      </div>
    </div>
  </div>
</div>
