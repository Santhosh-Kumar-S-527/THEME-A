---
import type { ArticleItem } from '../../types';

interface Props {
  article: ArticleItem;
}

const { article } = Astro.props;

// Editorial abstract patterns for article card visual
const cardPalettes = [
  'from-[#FDEEE8] via-[#FAF7F5] to-white',
  'from-[#FAF7F5] via-[#FDEEE8] to-white',
  'from-[#FAF7F5] via-white to-[#FDEEE8]',
  'from-[#FDEEE8] via-white to-[#FAF7F5]',
];
const palette = cardPalettes[article.id.length % cardPalettes.length];
---

<article class="group bg-white border border-[#E6E2DF] hover:border-[#E7430B] rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-xl flex flex-col justify-between">
  <div>
    <!-- Visual Image / Canvas -->
    <div class:list={['relative aspect-[16/10] overflow-hidden bg-gradient-to-br p-6 flex flex-col justify-between border-b border-[#E6E2DF]', palette]}>
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-mono uppercase tracking-wider text-[#E7430B] font-semibold bg-white/90 backdrop-blur-sm px-2.5 py-1 rounded-full border border-[#E6E2DF]">
          {article.category}
        </span>
        <span class="text-[11px] font-mono text-[#6B737A]">
          {article.readTime}
        </span>
      </div>

      <!-- Abstract Graphic Geometry -->
      <div class="flex items-center justify-center opacity-70 group-hover:scale-105 transition-transform duration-300">
        <svg class="w-20 h-20 text-[#E7430B]/30" viewBox="0 0 100 100" fill="none" stroke="currentColor">
          <circle cx="50" cy="50" r="36" stroke-width="2" stroke-dasharray="4 4" />
          <circle cx="50" cy="50" r="18" fill="#E7430B" fill-opacity="0.1" stroke-width="2" />
          <path d="M50 14 V86 M14 50 H86" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </div>

      <div class="text-[11px] font-mono text-[#6B737A]">
        {article.date}
      </div>
    </div>

    <!-- Content Area -->
    <div class="p-6">
      <h3 class="font-heading font-semibold text-base sm:text-lg text-[#111315] mb-2 leading-snug group-hover:text-[#E7430B] transition-colors line-clamp-2">
        <a href={article.url} class="focus-visible:outline-2 focus-visible:outline-[#E7430B]">
          {article.title}
        </a>
      </h3>

      <p class="text-xs sm:text-sm font-sans text-[#6B737A] leading-relaxed line-clamp-2">
        {article.summary}
      </p>
    </div>
  </div>

  <!-- Read Action -->
  <div class="px-6 pb-6 pt-0">
    <a
      href={article.url}
      class="inline-flex items-center text-xs font-semibold text-[#E7430B] hover:text-[#F4511E] transition-colors gap-1.5"
    >
      <span>Read article</span>
      <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor">
        <path d="M3.333 8h9.334M8.667 4l4 4-4 4" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</article>
