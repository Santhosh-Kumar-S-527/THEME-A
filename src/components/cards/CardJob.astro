---
import BadgeTag from '../common/BadgeTag.astro';
import Button from '../common/Button.astro';
import type { JobItem } from '../../types';

interface Props {
  job: JobItem;
}

const { job } = Astro.props;
---

<article class="group relative bg-white border border-[#E6E2DF] hover:border-[#F05B36] rounded-3xl p-8 transition-all duration-300 hover:shadow-xl flex flex-col justify-between">
  <div>
    <!-- Eyebrow department -->
    <span class="block text-xs font-bold uppercase tracking-[0.12em] text-[#E7430B] font-sans mb-3">
      {job.department}
    </span>

    <!-- Job Title -->
    <h3 class="text-xl sm:text-2xl font-heading font-medium text-[#111315] mb-3 group-hover:text-[#E7430B] transition-colors">
      {job.title}
    </h3>

    <!-- Description -->
    <p class="text-sm font-sans text-[#4A5157] leading-relaxed mb-6">
      {job.description}
    </p>

    <!-- Meta Tags -->
    <div class="flex flex-wrap gap-2 mb-8">
      {job.tags.map((tag) => (
        <BadgeTag variant="neutral" size="sm">
          {tag}
        </BadgeTag>
      ))}
    </div>
  </div>

  <!-- Action Row -->
  <div class="flex items-center justify-between pt-6 border-t border-[#E6E2DF] gap-4">
    <Button href={job.applyUrl} variant="primary" size="sm" withArrow={true}>
      Apply Now
    </Button>
    <a
      href={job.applyUrl}
      class="text-xs font-semibold text-[#4A5157] hover:text-[#E7430B] transition-colors py-2"
    >
      View Role Details →
    </a>
  </div>
</article>
