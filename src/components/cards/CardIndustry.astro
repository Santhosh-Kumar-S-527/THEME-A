---
import type { IndustryItem } from '../../types';

interface Props {
  industry: IndustryItem;
  class?: string;
  showDetails?: boolean;
  showMetric?: boolean;
}

const {
  industry,
  class: className = '',
  showDetails = false,
  showMetric = false,
} = Astro.props;

const fallbackImage = '/images/industries/retail.jpg';
const imageSrc = industry.image || fallbackImage;
---

<a
  href={`/industries#${industry.slug}`}
  class:list={[
    'group relative block aspect-[3/4] rounded-2xl overflow-hidden border border-[#293036]/80 hover:border-[#F05B36]/80 transition-all duration-500 focus:outline-none focus:ring-2 focus:ring-[#F05B36] focus:ring-offset-2 focus:ring-offset-[#050708]',
    className
  ]}
  aria-label={`Explore ${industry.title} industry solutions`}
>
  <!-- Dedicated realistic photographic image with smooth hover zoom -->
  <img
    src={imageSrc}
    alt={`${industry.title} industry`}
    loading="lazy"
    decoding="async"
    class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
  />

  <!-- High-contrast bottom gradient overlay (WCAG 2.2 AA compliant) -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none transition-opacity duration-300 group-hover:from-black/90"></div>

  <!-- Content overlay: Bottom-left title + Bottom-right subtle icon -->
  <div class="absolute inset-0 p-3.5 sm:p-4 flex flex-col justify-between z-10 pointer-events-none">
    {showMetric && industry.metrics ? (
      <div class="flex items-start justify-between">
        <span class="text-[10px] font-mono tracking-wide text-white/80 bg-black/50 backdrop-blur-sm border border-white/10 px-2 py-0.5 rounded-full">
          {industry.metrics}
        </span>
      </div>
    ) : (
      <div></div>
    )}

    <div class="flex items-end justify-between gap-1">
      <div class="min-w-0">
        <h3 class="text-[12px] sm:text-[13px] lg:text-[14px] font-heading font-medium text-white group-hover:text-white transition-colors leading-snug tracking-tight">
          {industry.title}
        </h3>
        {showDetails && industry.description && (
          <p class="text-xs font-sans text-[#A0A6AD] mt-1 line-clamp-2 leading-relaxed">
            {industry.description}
          </p>
        )}
      </div>

      <!-- Bottom-right corner subtle icon -->
      <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-white/10 backdrop-blur-md border border-white/15 flex items-center justify-center text-white/60 group-hover:text-white group-hover:bg-[#E7430B] group-hover:border-[#E7430B] transition-all duration-300 flex-shrink-0">
        <svg class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor">
          <path d="M4 12L12 4M12 4H6M12 4V10" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>
  </div>
</a>
