---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
---

<BaseLayout
  title="404 — Page Not Found | Lingaasys"
  description="The page you are looking for does not exist or has been moved."
  showAnnouncement={false}
>
  <section class="py-32 bg-white text-center">
    <Container class="max-w-2xl">
      <span class="inline-block text-xs font-mono font-bold uppercase tracking-widest text-[#E7430B] mb-4">
        Error 404
      </span>
      <h1 class="text-4xl sm:text-6xl font-heading font-medium text-[#111315] mb-4">
        Page Not Found
      </h1>
      <p class="text-base sm:text-lg font-sans text-[#4A5157] mb-8 leading-relaxed">
        The requested resource could not be found. It may have been relocated or updated as part of our platform improvements.
      </p>
      <div class="flex items-center justify-center gap-4">
        <Button href="/" variant="primary" size="md" withArrow={true}>
          Return Home
        </Button>
        <Button href="/technologies" variant="secondary" size="md">
          Explore Technologies
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
